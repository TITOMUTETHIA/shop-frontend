<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ShopFrontend</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Add Blazor component packages so the shared Razor components compile
         when referenced from Blazor WebAssembly. Runtime-specific packages
         (EF Core, ASP.NET Core frameworks) are provided by consuming apps. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <!-- Add EF Core abstractions for compile-time when shared by MAUI and Web projects -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <RazorComponent Include="..\Components\**\*.razor" Link="Components\%(RecursiveDir)%(Filename)%(Extension)" />
    <RazorComponent Include="..\Routes.razor" Link="Routes.razor" />
    <!-- Models are only required for non-WASM builds (they include EF types). -->
    <Compile Include="..\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(RuntimeIdentifier)' != 'browser-wasm'" />

    <!-- Always include service interfaces so Blazor WebAssembly consumers can compile against them.
         Concrete service implementations (EF-backed) remain excluded for browser-wasm. -->
    <Compile Include="..\Services\IShopProductService.cs" Link="Services\IShopProductService.cs" />
    <Compile Include="..\Services\IShoppingCartService.cs" Link="Services\IShoppingCartService.cs" />
    <Compile Include="..\Services\IShopOrderService.cs" Link="Services\IShopOrderService.cs" />
    <Compile Include="..\Services\IShopCustomerService.cs" Link="Services\IShopCustomerService.cs" />
    <Compile Include="..\Services\IShopCatalogService.cs" Link="Services\IShopCatalogService.cs" />
    <Compile Include="..\Services\IShopCategoryService.cs" Link="Services\IShopCategoryService.cs" Condition="Exists('..\\Services\\IShopCategoryService.cs')" />
  </ItemGroup>

</Project>
